# Maintainer: Pretty <replace-with-email>

pkgname=allyas-git
_pkgname=allyas
pkgver=0.1.0.r0.g0000000
pkgrel=1
pkgdesc='Local-first shell alias manager written in Go'
arch=('x86_64')
url='https://github.com/prettyletto/allyas'
license=('MIT')
depends=('glibc')
makedepends=('git' 'go')
provides=('allyas')
conflicts=('allyas')
source=("git+https://github.com/prettyletto/allyas.git#branch=allyasv2")
sha256sums=('SKIP')

pkgver() {
  cd "$srcdir/$_pkgname"
  git describe --long --tags --always | sed 's/^v//;s/-/.r/;s/-/./'
}

build() {
  cd "$srcdir/$_pkgname"

  export CGO_CPPFLAGS="${CPPFLAGS}"
  export CGO_CFLAGS="${CFLAGS}"
  export CGO_CXXFLAGS="${CXXFLAGS}"
  export CGO_LDFLAGS="${LDFLAGS}"
  export GOFLAGS="-buildmode=pie -trimpath -mod=readonly -modcacherw"

  go build \
    -ldflags "-linkmode external -X main.version=${pkgver}" \
    -o allyas \
    ./cmd/allyas
}

check() {
  cd "$srcdir/$_pkgname"
  go test ./...
}

package() {
  cd "$srcdir/$_pkgname"

  install -Dm755 allyas "$pkgdir/usr/bin/allyas"
  install -Dm644 README.md "$pkgdir/usr/share/doc/allyas/README.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/allyas/LICENSE"
}
